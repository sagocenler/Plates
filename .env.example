# Default mode (npm run dev) is fully local and needs no configuration.
#
# Supabase mode: copy this to .env.supabase.local (git-ignored) and run `npm run dev:supabase`.
# Only the project URL and the PUBLISHABLE key belong here. Never put a service_role / secret key
# or a Google Places key in any VITE_ variable: everything VITE_ is shipped to the browser.
VITE_DATA_BACKEND=supabase
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
